<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- BepInEx packages (BepInEx.Core, HarmonyX, ...) are hosted on the BepInEx feed,
         not nuget.org. nuget.org stays enabled for everything else. -->
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
